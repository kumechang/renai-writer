// 調査員が収集したWebリサーチ情報を、ライターが記事執筆に使いやすい形で
// 蓄積するためのスキーマ。編集者(企画)・ライター(執筆)は将来的にこのデータを
// 消費する側として連携する想定。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 調査テーマ（編集者の企画に対応する調査単位）
model Topic {
  id        String   @id @default(cuid())
  title     String
  // 記事の切り口・想定読者など、調査員が集めるべき情報の方向性
  theme     String?
  // 編集者からの調査依頼メモ（将来、企画立案機能と接続する想定）
  brief     String?
  // collecting: 収集中 / ready: ライターに提供可能 / archived: 使用終了
  status    String   @default("collecting")
  items     ResearchItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 収集元（同一URLは複数トピックから参照されうるため独立管理）
model Source {
  id          String   @id @default(cuid())
  url         String   @unique
  domain      String
  title       String?
  author      String?
  siteName    String?
  publishedAt DateTime?
  fetchedAt   DateTime @default(now())
  items       ResearchItem[]
}

// 調査員が収集した個別データ（ライターが直接参照する最小単位）
model ResearchItem {
  id           String   @id @default(cuid())
  topicId      String
  topic        Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])

  // ライターがそのまま使える要約（元記事の丸写しではなく調査員による要約）
  summary      String
  // 重要ポイントの箇条書き（JSON配列の文字列として保存）
  keyPoints    String   @default("[]")
  // 引用可能な一次情報（JSON配列: {text, context?} の文字列として保存）
  quotes       String   @default("[]")

  // 調査員による主観評価（1-5）。ライターが取捨選択する際の判断材料。
  reliability  Int      @default(3)
  relevance    Int      @default(3)

  tags         Tag[]    @relation("ResearchItemTags")

  // new: 未確認 / reviewed: 編集者確認済み / used: 記事で使用 / rejected: 不採用
  status       String   @default("new")
  collectedBy  String?
  notes        String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([topicId])
  @@index([sourceId])
}

model Tag {
  id    String         @id @default(cuid())
  name  String         @unique
  items ResearchItem[] @relation("ResearchItemTags")
}

// 編集者が立てる記事企画。テーマ(GitHub issue等)から、想定読者・構成・
// ボリューム・有料部分の設計・タイトル案までを1件にまとめて保持する。
// 1つの企画(50タイトル案)から、複数の記事(Article)を並行して書き分けることを想定する。
model Plan {
  id              String   @id @default(cuid())
  theme           String
  targetReader    String
  // Markdown形式の構成案(見出しごとに何を書くか。各Articleが土台として使う)
  structure       String
  // 記事全体および無料/有料部分の目安文字数の説明
  volume          String
  // 有料部分の区切り位置とその狙いの説明
  paidSection     String
  // タイトル案(JSON配列、ちょうど50件)
  titleCandidates String
  // 編集者が50件の中から選んだ、実際に記事化する推奨タイトル(JSON配列、ちょうど10件)
  recommendedTitles String
  // planning: submit_plan前 / ready: 各タイトルのArticleが作成済み
  status          String   @default("planning")
  articles        Article[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// 1つの企画から生まれる記事1本。タイトルごとに独立して執筆・レビューが進む。
model Article {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  // Plan.titleCandidatesのいずれかと一致する、この記事のタイトル
  title     String
  // drafting -> in_review -> (needs_revision を経て再度drafting) ->
  // accepted / accepted_with_reservation / needs_human_review
  status    String   @default("drafting")
  drafts    Draft[]
  xPosts    XPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
}

// ライターが提出した原稿の1版。revisionNumber 0が初稿、1・2が差し戻し後の修正稿。
model Draft {
  id             String   @id @default(cuid())
  articleId      String
  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  revisionNumber Int
  title          String
  content        String
  wordCount      Int
  review         Review?
  createdAt      DateTime @default(now())

  @@index([articleId])
}

// 編集者による1原稿へのレビュー結果。1原稿につき1件。
model Review {
  id             String   @id @default(cuid())
  draftId        String   @unique
  draft          Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
  score          Int
  // score >= 80 かどうか。80点未満でも、2回の差し戻し後で70点を超える場合は
  // Plan.status側で "accepted_with_reservation" として成立させる。
  passed         Boolean
  // 2回目の差し戻し後(最後の機会)のレビューかどうか
  isFinalAttempt Boolean  @default(false)
  feedback       String
  createdAt      DateTime @default(now())
}

// GitHub issueを介した「コンソール駆動」フローの進行状況を追跡する内部管理テーブル。
// Claude API(自動実行)を使わず、Claude.aiのコンソールに人間が手動でプロンプトを
// コピー&ペーストして実行し、その回答をissueコメントとして貼り付けてもらう運用を想定する。
// 1issueにつき同時に1つの保留中プロンプトのみを許容する。
model IssueSession {
  id          String @id @default(cuid())
  issueOwner  String
  issueRepo   String
  issueNumber Int

  topicId   String?
  planId    String?
  // sub-issue(1記事に対応)の場合にセットされる
  articleId String?

  // 保留中のステップ。null は保留中のプロンプトが無い状態。
  // "research" | "plan" | "draft" | "review"
  pendingStep String?
  // 保留中プロンプトのGitHubコメントID。このIDより新しいコメントを返信として探す。
  // GitHubのコメントIDは32bit intに収まらないためBigIntで保持する。
  pendingPromptCommentId BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issueOwner, issueRepo, issueNumber])
}

// 完成した記事(Article)をXで告知する投稿。ライターが記事を宣伝する文面を作成し、
// GitHub issueでの人による承認を経てXに投稿する(amazon-sentaku-shiageのX自動投稿の
// 仕組み(Claude APIでの文面生成・セルフチェック・Issue承認・X投稿)を流用している)。
model XPost {
  id        String  @id @default(cuid())
  articleId String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  draftId   String
  // 記事の公開先URL(任意)。renai-writer自体は記事を公開しないため、公開後に運用者が指定する。
  articleUrl String?

  generatedText String
  // セルフチェック後の最終投稿文(不合格なら修正済み)。実際にXへ投稿されるのはこちら。
  finalText     String
  selfCheckJson String?

  // pending_approval -> approved / rejected -> posted / posted_dryrun / post_failed
  status String @default("pending_approval")

  githubIssueOwner  String?
  githubIssueRepo   String?
  githubIssueNumber Int?
  githubIssueUrl    String?

  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?

  tweetId       String?
  tweetUrl      String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
}
