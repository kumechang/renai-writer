DATABASE_URL="file:./dev.db"
PORT=3000

# エージェント(npm run researcher / npm run pipeline)共通
ANTHROPIC_API_KEY=
RESEARCH_API_BASE_URL="http://localhost:3000"
RESEARCHER_AGENT_NAME="claude-researcher-agent"

# npm run pipeline -- --issue owner/repo#番号 を使う場合に必要
# (issue本文の取得だけならpublicリポジトリでは不要だが、完成した記事をissueに
#  コメント投稿するには issues:write 権限を持つトークンが常に必要)
GITHUB_TOKEN=
