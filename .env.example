DATABASE_URL="file:./dev.db"
PORT=3000

# エージェント共通
RESEARCH_API_BASE_URL="http://localhost:3000"

# npm run console (コンソール駆動、推奨) に必要。Anthropic APIは呼ばないので
# ANTHROPIC_API_KEYは不要。issues:write 権限を持つトークンを指定すること。
GITHUB_TOKEN=

# npm run researcher / npm run pipeline (自動実行、Anthropic APIを直接呼び出し費用が発生)
# を使う場合のみ必要
ANTHROPIC_API_KEY=
RESEARCHER_AGENT_NAME="claude-researcher-agent"

# npm run x-post:generate / npm run x-post:handle-approval (完成した記事をXで告知する仕組み。
# amazon-sentaku-shiageのX自動投稿の仕組みを流用。Claude APIを直接呼び出し費用が発生) に必要
# 承認issueの作成先(owner/repo形式)。GitHub Actions上では自動で設定されるため、
# ローカルからnpm run x-post:generateを実行する場合のみ指定すること。
GITHUB_REPOSITORY="kumechang/renai-writer"

# X (Twitter) API v2 - user context (OAuth 1.0a)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
